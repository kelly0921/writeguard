{
  "name": "closure-writeguard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --configLoader runner",
    "test:unit": "vitest run --configLoader runner --exclude \"tests/**/*.integration.test.ts\"",
    "test:integration": "cross-env TEST_DATABASE_URL=postgresql://closure:closure@localhost:54327/closure vitest run --configLoader runner tests/postgres.integration.test.ts tests/agent.integration.test.ts tests/support.integration.test.ts tests/concurrency.integration.test.ts tests/shadow.integration.test.ts tests/starter.integration.test.ts tests/pilot.integration.test.ts",
    "test:concurrency": "cross-env TEST_DATABASE_URL=postgresql://closure:closure@localhost:54327/closure vitest run --configLoader runner tests/concurrency.integration.test.ts",
    "test:shadow": "cross-env TEST_DATABASE_URL=postgresql://closure:closure@localhost:54327/closure vitest run --configLoader runner tests/shadow.test.ts tests/shadow.integration.test.ts",
    "test:starter": "cross-env TEST_DATABASE_URL=postgresql://closure:closure@localhost:54327/closure vitest run --configLoader runner tests/starter.integration.test.ts",
    "db:migrate": "tsx packages/core/src/db/migrate.ts",
    "demo:fake": "tsx apps/refund-demo/src/cli.ts fake",
    "demo:ordinary": "tsx apps/refund-demo/src/cli.ts ordinary",
    "demo:stripe": "tsx apps/refund-demo/src/cli.ts stripe",
    "demo:agent": "tsx apps/agent-demo/src/cli.ts",
    "demo:support-refund": "tsx apps/support-refund/src/cli.ts",
    "demo:starter": "tsx apps/design-partner-starter/src/cli.ts",
    "demo:public": "node scripts/public-demo.mjs",
    "package:verify": "node scripts/verify-package.mjs",
    "package:verify-openai-analyzer": "node scripts/verify-openai-analyzer-package.mjs",
    "package:verify-generator": "node scripts/verify-generator-package.mjs",
    "verify:core-openai-boundary": "node scripts/verify-core-openai-boundary.mjs",
    "verify:generator-boundary": "node scripts/verify-generator-boundary.mjs",
    "eval:openai-live": "pnpm --filter @closure/writeguard build && pnpm --filter @closure/writeguard-analyzer-openai build && node scripts/live-openai-analyzer-eval.mjs",
    "validate:generated-artifacts": "pnpm --filter @closure/writeguard build && pnpm --filter @closure/writeguard-generator build && node scripts/validate-generated-artifacts.mjs",
    "package:inspect": "node scripts/inspect-tarball.mjs",
    "writeguard:report": "node scripts/writeguard-report.mjs",
    "writeguard:doctor": "tsx apps/pilot-sandbox/src/cli.ts doctor",
    "writeguard": "tsx packages/writeguard/src/cli.ts",
    "security:scan": "node scripts/scan-secrets.mjs",
    "security:audit": "pnpm audit --prod",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "pilot:start": "node scripts/pilot-control.mjs start",
    "pilot:setup": "tsx apps/pilot-sandbox/src/cli.ts setup",
    "pilot:validate": "tsx apps/pilot-sandbox/src/cli.ts validate",
    "pilot:report": "tsx apps/pilot-sandbox/src/cli.ts report",
    "pilot:export": "tsx apps/pilot-sandbox/src/cli.ts export",
    "pilot:reset": "tsx apps/pilot-sandbox/src/cli.ts reset",
    "pilot:stop": "node scripts/pilot-control.mjs stop",
    "validate:milestone-2": "pnpm db:migrate && pnpm security:scan && pnpm typecheck && pnpm build && pnpm test:unit && pnpm test:integration && pnpm demo:ordinary && pnpm demo:fake -- --scenario=success && pnpm demo:agent && pnpm demo:support-refund",
    "validate:design-partner": "node scripts/validate-design-partner.mjs",
    "validate:pilot-ready": "node scripts/validate-pilot-ready.mjs",
    "validate:pilot-ci": "node scripts/validate-pilot-ready.mjs --ci",
    "validate:build-week-iteration-1": "node scripts/validate-build-week-iteration-1.mjs",
    "validate:build-week-iteration-2": "node scripts/validate-build-week-iteration-2.mjs",
    "validate:build-week-iteration-3": "node scripts/validate-build-week-iteration-3.mjs",
    "inspect": "tsx apps/refund-demo/src/cli.ts inspect"
  },
  "devDependencies": {
    "@closure/writeguard": "workspace:*",
    "@closure/writeguard-analyzer-openai": "workspace:*",
    "@closure/writeguard-generator": "workspace:*",
    "@writeguard/core": "workspace:*",
    "@writeguard/sdk": "workspace:*",
    "@writeguard/stripe-adapter": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.0",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
