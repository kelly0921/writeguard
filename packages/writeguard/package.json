{
  "name": "@closure/writeguard",
  "version": "0.7.0",
  "description": "Durable execution control, explicit uncertainty, reconciliation, and receipts for agent-triggered external writes.",
  "type": "module",
  "main": "./dist/writeguard/src/index.js",
  "types": "./dist/writeguard/src/index.d.ts",
  "bin": {
    "writeguard": "./dist/writeguard/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/writeguard/src/index.d.ts",
      "import": "./dist/writeguard/src/index.js"
    },
    "./testing": {
      "types": "./dist/writeguard/src/testing.d.ts",
      "import": "./dist/writeguard/src/testing.js"
    },
    "./analysis": {
      "types": "./dist/writeguard/src/analysis/index.d.ts",
      "import": "./dist/writeguard/src/analysis/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
