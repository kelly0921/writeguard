{
  "name": "@closure/writeguard-generator",
  "version": "0.3.1",
  "description": "Deterministic WriteGuard generation plus integrity, compilation, and opt-in failure-test verification.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@closure/writeguard": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
