# WriteGuard local pilot sandbox. Copy to .env.pilot; this file contains no credentials.
PILOT_MODE=shadow
PILOT_NAMESPACE=writeguard-pilot
PILOT_DATABASE_URL=postgresql://writeguard:writeguard@127.0.0.1:54328/writeguard_pilot
PILOT_STORAGE=postgresql
PILOT_PROVIDER=fake
PILOT_TELEMETRY_ENABLED=true
PILOT_TELEMETRY_FILE=.writeguard/pilot-telemetry.jsonl
PILOT_RECONCILIATION_ENABLED=true
PILOT_RECEIPT_RETENTION_DAYS=30
PILOT_SENSITIVE_FIELD_POLICY=omit
PILOT_FAIL_CLOSED_ON_STORAGE_ERROR=true

# Optional enforced Stripe test-mode validation. Live keys are rejected.
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_INTENT_ID=
STRIPE_PAYMENT_INTENT_AMOUNT=500
STRIPE_REFUND_AMOUNT=100
STRIPE_CURRENCY=usd
